{
  "name": "music-video",
  "version": "1.0.0",
  "private": true,
  "description": "Beat-synced music video: a time-seeked HTML page captured frame by frame with Playwright and encoded with ffmpeg.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "setup:env": "node scripts/setup-env.mjs",
    "setup:align": "node scripts/setup-align.mjs",
    "fonts": "node scripts/fonts.mjs",
    "analyze": "node scripts/analyze.mjs",
    "analyze:reset": "node scripts/analyze.mjs --reset",
    "align": "node scripts/align.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test --test-concurrency=2 \"tests/*.test.mjs\"",
    "test:render": "node --test --test-concurrency=1 \"tests/render/*.test.mjs\"",
    "serve": "node scripts/serve.mjs",
    "still": "node scripts/still.mjs",
    "draft": "node scripts/draft.mjs",
    "render": "node scripts/render.mjs",
    "preview": "node scripts/preview.mjs",
    "contact-sheet": "node scripts/contact-sheet.mjs",
    "posters": "node scripts/posters.mjs",
    "critique": "node scripts/critique.mjs",
    "pops": "node scripts/pops.mjs",
    "still-test": "node scripts/still-test.mjs",
    "jitter": "node scripts/jitter.mjs",
    "beatmap": "node scripts/beatmap.mjs",
    "clips": "node scripts/clips.mjs",
    "draft:vertical": "node scripts/draft.mjs --pipeline=src/pipeline.vertical.json",
    "render:vertical": "node scripts/render.mjs --pipeline=src/pipeline.vertical.json",
    "preview:vertical": "node scripts/preview.mjs --pipeline=src/pipeline.vertical.json",
    "clips:vertical": "node scripts/clips.mjs --pipeline=src/pipeline.vertical.json"
  }
}
